# GENERATED by `make migrate` (tools/migrate/migrate.py) from secrets.yaml and
# the probe addresses of {{FROM}}. It holds this controller's secrets: LOCAL
# ONLY. Never commit, copy or share it; `make migrate-clean` deletes it and its
# build. See docs/plans/secret-free-firmware.md, WP8.
#
# The generic firmware, plus one boot step that fills every EMPTY setting with
# the value the controller was built with until now (tools/migrate/
# migration_seed.h), once per build of this file. A set value is never
# overwritten.
packages:
  controller: !include ../pool-controller.yaml

esphome:
  includes:
    - ../tools/migrate/migration_seed.h
  on_boot:
    # After the globals' restore (800), before device-settings.yaml applies
    # them (700), wifi loads its network (250) and the API its key (200): see
    # migration_seed.h.
    - priority: 750
      then:
        - lambda: |-
            static const pool_migration::OldSettings old{
                {{WIFI_SSID}},
                {{WIFI_PASSWORD}},
                {{API_KEY}},
                {{PAGE_PASSWORD}},
                {{OTA_PASSWORD}},
                {{LATITUDE}},
                {{LONGITUDE}},
                {{TIMEZONE_POSIX}},
                {{TIMEZONE_NAME}},
                {{POOL_PROBE}},
                {{PAD_PROBE}},
                {{OUTDOOR_PROBE}},
            };
            pool_migration::Settings to{
                id(page_password), id(ota_password), id(latitude), id(longitude),
                id(timezone_posix), id(timezone_name),
                id(pool_probe_address), id(pad_probe_address), id(outdoor_probe_address),
            };
            pool_migration::seed_all(old, to, id(migration_run), {{RUN_ID}});
    # Commits what the step above filled now rather than at the next
    # flash_write_interval: device-settings.yaml's settings_save lets the
    # globals' 1 s poll write them, then syncs NVS.
    - priority: -100
      then:
        - script.execute: settings_save

globals:
  # The last migration build that seeded (its run id), so it seeds once: a
  # Factory Reset while it is installed stays a reset.
  - id: migration_run
    type: uint32_t
    restore_value: true
    initial_value: '0'
