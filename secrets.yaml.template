# Copy this file to secrets.yaml and fill in your real values.
# secrets.yaml itself is gitignored -- never commit it.

wifi_ssid: "WIFI_SSID"
wifi_password: "WIFI_PASSWORD"

# Must be a base64-encoded 32-byte key. Generate your own with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
pool_controller_api_key: "API_KEY"

pool_controller_ota_password: "OTA_PASSWORD"

# Used by the autonomous filtration schedule to compute today's sunrise/
# sunset (and, via the timezone, local midnight). Treated as sensitive --
# together they reveal the pool's approximate location -- same as the
# credentials above, hence secrets.yaml rather than the substitutions: block
# in pool-controller.yaml.
pool_latitude: "LATITUDE"
pool_longitude: "LONGITUDE"
pool_timezone: "TIMEZONE"   # IANA zone, e.g. "Europe/Paris"
